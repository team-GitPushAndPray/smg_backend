generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Rol {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique
  descripcion String?
  activo      Boolean     @default(true)
  es_sistema  Boolean     @default(false)

  usuarios    Usuario[]
  modulos     RolModulo[]

  @@map("roles")
}

model Modulo {
  id     Int         @id @default(autoincrement())
  codigo String      @unique
  nombre String

  roles  RolModulo[]

  @@map("modulos")
}

model RolModulo {
  rol_id       Int
  modulo_id    Int
  puede_editar Boolean @default(false)

  rol    Rol    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  modulo Modulo @relation(fields: [modulo_id], references: [id], onDelete: Cascade)

  @@id([rol_id, modulo_id])
  @@map("rol_modulo")
}

model Usuario {
  id               Int    @id @default(autoincrement())
  rol_id           Int       
  nombre           String
  apellido         String
  email            String    @unique
  password         String
  telefono         String?   
  telegram_chat_id String?   
  activo           Boolean   @default(true)
  ultimo_acceso    DateTime? 

  creado_en        DateTime  @default(now())
  actualizado_en   DateTime  @updatedAt

  rol              Rol       @relation(fields: [rol_id], references: [id])

  @@map("usuarios") 
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  equipos     Equipo[]

  @@map("categorias")
}

model Equipo {
  id             Int         @id @default(autoincrement())
  codigo_interno String      @unique
  qr_token       String      @unique @default(uuid()) @db.Uuid
  marca          String?
  estado         String
  ubicacion      String?
  descripcion    String?
  activo         Boolean     @default(true)
  
  id_categoria   Int
  categoria      Categoria   @relation(fields: [id_categoria], references: [id])

  maquina        Maquina?
  aditamento     Aditamento?
  checklist       Checklist[]

  @@map("equipos")
}

model Maquina {
  equipo_id          Int    @id
  modelo             String
  anio               Int
  n_serie            String
  horas_motor_actual Int
  horas_actualizadas_en DateTime? @db.Timestamp()  
  
  equipo             Equipo @relation(fields: [equipo_id], references: [id], onDelete: Cascade)

  @@map("maquinas")
}

model Aditamento {
  equipo_id Int    @id
  equipo    Equipo @relation(fields: [equipo_id], references: [id], onDelete: Cascade)

  @@map("aditamentos")
}

enum CargoVendedor {
  LOGISTICA
  VENTAS
  ALQUILERES
  REPUESTOS
}

model Vendedor {
  id          Int           @id @default(autoincrement())
  nombre      String
  cargo       CargoVendedor
  descripcion String?       @db.VarChar(255)
  foto        String?       
  contacto    String        
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt 

  @@map("vendedores")
}


enum TipoPlantilla {
  DIARIO
  MANTENIMIENTO
  ALQUILERES
}

enum TipoChecklist {
  DIARIO
  MANTENIMIENTO
  ENTREGA
  DEVOLUCION
}

enum EstadoItem {
  NORMAL
  ANORMAL
  NO_APLICA
}


model PlantillaChecklist {
  id     Int             @id @default(autoincrement())
  tipo   TipoPlantilla   @unique
  nombre String

  items  PlantillaItem[]

  @@map("plantilla_checklist")
}


model PlantillaItem {
  id           Int                  @id @default(autoincrement())
  plantilla_id Int
  nombre       String
  orden        Int
  activo       Boolean              @default(true)

  plantilla    PlantillaChecklist   @relation(fields: [plantilla_id], references: [id], onDelete: Restrict)
  respuestas   ChecklistRespuesta[]

  @@unique([plantilla_id, orden])
  @@map("plantilla_item")
}


model Checklist {
  id            Int                  @id @default(autoincrement())
  tipo          TipoChecklist
  fecha         DateTime             @default(now())
  equipo_id     Int
  usuario_id    Int?                 
  horas_motor   Int?                 
  observaciones String?              @db.Text

  equipo        Equipo               @relation(fields: [equipo_id], references: [id], onDelete: Restrict)
  respuestas    ChecklistRespuesta[]
  fotos         ChecklistFoto[]      

  @@map("checklist")
}

model ChecklistRespuesta {
  id                Int           @id @default(autoincrement())
  checklist_id      Int
  plantilla_item_id Int
  estado            EstadoItem
  observacion       String?       @db.Text

  checklist         Checklist     @relation(fields: [checklist_id], references: [id], onDelete: Restrict)
  plantilla_item    PlantillaItem @relation(fields: [plantilla_item_id], references: [id], onDelete: Restrict)

  @@unique([checklist_id, plantilla_item_id])
  @@map("checklist_respuesta")
}


model ChecklistFoto {
  id           Int       @id @default(autoincrement())
  checklist_id Int
  url          String

  checklist    Checklist @relation(fields: [checklist_id], references: [id], onDelete: Restrict)

  @@map("checklist_foto")
}