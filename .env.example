# Base de datos
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/logistica_automotor?schema=public"

# pgAdmin (Docker)
POSTGRES_USER=usuario_ejemplo
POSTGRES_PASSWORD=password_ejemplo
POSTGRES_DB=logistica_automotor
PGADMIN_DEFAULT_EMAIL=admin@ejemplo.com
PGADMIN_DEFAULT_PASSWORD=admin

SUPERADMIN_EMAIL=superadmins@ejemplo.com
SUPERADMIN_PASSWORD=superadmincontrasenia

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

AVISO_ANTICIPACION_HORAS=50
AVISO_ANTICIPACION_DIAS=30
CRON_SECRET=tu_secreto_para_vercel_cron

# Notificaciones (Telegram & Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_TALLER=-100000000
TELEGRAM_CHAT_GERENCIA=-100000000

MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME="SGM Avisos"