generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Rol {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique
  descripcion String?
  activo      Boolean     @default(true)
  es_sistema  Boolean     @default(false)

  usuarios    Usuario[]
  modulos     RolModulo[]

  @@map("roles")
}

model Modulo {
  id     Int         @id @default(autoincrement())
  codigo String      @unique
  nombre String

  roles  RolModulo[]

  @@map("modulos")
}

model RolModulo {
  rol_id    Int
  modulo_id Int

  rol       Rol    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  modulo    Modulo @relation(fields: [modulo_id], references: [id], onDelete: Cascade)

  @@id([rol_id, modulo_id])
  @@map("rol_modulo")
}

model Usuario {
  id               Int    @id @default(autoincrement())
  rol_id           Int       
  nombre           String
  apellido         String
  email            String    @unique
  password         String
  telefono         String?   
  telegram_chat_id String?   
  activo           Boolean   @default(true)
  ultimo_acceso    DateTime? 

  creado_en        DateTime  @default(now())
  actualizado_en   DateTime  @updatedAt

  rol              Rol       @relation(fields: [rol_id], references: [id])

  @@map("usuarios") 
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  equipos     Equipo[]

  @@map("categorias")
}

model Equipo {
  id             Int         @id @default(autoincrement())
  codigo_interno String      @unique
  marca          String?
  estado         String
  ubicacion      String?
  descripcion    String?
  activo         Boolean     @default(true)
  
  id_categoria   Int
  categoria      Categoria   @relation(fields: [id_categoria], references: [id])

  maquina        Maquina?
  aditamento     Aditamento?

  @@map("equipos")
}

model Maquina {
  equipo_id          Int    @id
  modelo             String
  anio               Int
  n_serie            String
  horas_motor_actual Int  
  
  equipo             Equipo @relation(fields: [equipo_id], references: [id], onDelete: Cascade)

  @@map("maquinas")
}

model Aditamento {
  equipo_id Int    @id
  equipo    Equipo @relation(fields: [equipo_id], references: [id], onDelete: Cascade)

  @@map("aditamentos")
}

enum CargoVendedor {
  LOGISTICA
  VENTAS
  ALQUILERES
  REPUESTOS
}

model Vendedor {
  id          Int           @id @default(autoincrement())
  nombre      String
  cargo       CargoVendedor
  descripcion String?       @db.VarChar(255)
  foto        String?       
  contacto    String        
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt 

  @@map("vendedores")
}