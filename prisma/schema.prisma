generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Rol {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique
  descripcion String?
  activo      Boolean     @default(true)
  es_sistema  Boolean     @default(false)

  usuarios    Usuario[]
  modulos     RolModulo[]

  @@map("roles")
}

model Modulo {
  id     Int         @id @default(autoincrement())
  codigo String      @unique
  nombre String

  roles  RolModulo[]

  @@map("modulos")
}

model RolModulo {
  rol_id       Int
  modulo_id    Int
  puede_editar Boolean @default(false)

  rol    Rol    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  modulo Modulo @relation(fields: [modulo_id], references: [id], onDelete: Cascade)

  @@id([rol_id, modulo_id])
  @@map("rol_modulo")
}

model Usuario {
  id               Int       @id @default(autoincrement())
  rol_id           Int       
  nombre           String
  apellido         String
  email            String    @unique
  password         String
  telefono         String?   
  telegram_chat_id String?   
  activo           Boolean   @default(true)
  ultimo_acceso    DateTime? 

  creado_en        DateTime  @default(now())
  actualizado_en   DateTime  @updatedAt

  rol              Rol       @relation(fields: [rol_id], references: [id])

  alquileres       Alquiler[]
  avisos_atendidos Aviso[]

  @@map("usuarios") 
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  equipos     Equipo[]

  @@map("categorias")
}

model Equipo {
  id             Int              @id @default(autoincrement())
  codigo_interno String           @unique
  qr_token       String           @unique @default(uuid()) @db.Uuid
  marca          String?
  estado         EstadoEquipo     @default(disponible) 
  ubicacion      String?
  descripcion    String?
  activo         Boolean          @default(true)
  
  id_categoria   Int
  categoria      Categoria        @relation(fields: [id_categoria], references: [id])

  maquina        Maquina?
  aditamento     Aditamento?
  checklist      Checklist[]
  alquileres     AlquilerEquipo[]

  @@map("equipos")
}

model Maquina {
  equipo_id              Int       @id
  modelo                 String
  anio                   Int
  n_serie                String
  horas_motor_actual     Int
  horas_actualizadas_en  DateTime? @db.Timestamp()
  certificacion_vence_el DateTime? @db.Date
  
  equipo                 Equipo    @relation(fields: [equipo_id], references: [id], onDelete: Cascade)
  avisos                 Aviso[]

  @@map("maquinas")
}

model Aditamento {
  equipo_id Int    @id
  equipo    Equipo @relation(fields: [equipo_id], references: [id], onDelete: Cascade)

  @@map("aditamentos")
}

enum CargoVendedor {
  LOGISTICA
  VENTAS
  ALQUILERES
  REPUESTOS
}

model Vendedor {
  id          Int           @id @default(autoincrement())
  nombre      String
  cargo       CargoVendedor
  descripcion String?       @db.VarChar(255)
  foto        String?       
  contacto    String        
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt 

  @@map("vendedores")
}

enum TipoPlantilla {
  DIARIO
  MANTENIMIENTO
  ALQUILERES
}

enum TipoChecklist {
  DIARIO
  MANTENIMIENTO
  ENTREGA
  DEVOLUCION
}

enum EstadoItem {
  NORMAL
  ANORMAL
  NO_APLICA
}

enum EstadoEquipo {
  disponible
  alquilado
  en_taller
  fuera_de_servicio
}

enum EstadoAlquiler {
  PENDIENTE
  ACTIVO
  FINALIZADO
  ANULADO
}

enum AplicaA {
  MAQUINA
  ADITAMENTO
}

enum TipoAviso {
  SERVICIO
  CERTIFICACION
}

enum EstadoAviso {
  PENDIENTE
  ATENDIDO
}

model PlantillaChecklist {
  id       Int             @id @default(autoincrement())
  nombre   String          @unique
  tipo     TipoPlantilla
  aplica_a AplicaA?
  activo   Boolean         @default(true)

  items    PlantillaItem[]

  @@unique([tipo, aplica_a])
  @@map("plantilla_checklist")
}

model PlantillaItem {
  id           Int                  @id @default(autoincrement())
  plantilla_id Int
  nombre       String
  orden        Int
  activo       Boolean              @default(true)

  plantilla    PlantillaChecklist   @relation(fields: [plantilla_id], references: [id], onDelete: Restrict)
  respuestas   ChecklistRespuesta[]

  @@unique([plantilla_id, orden])
  @@map("plantilla_item")
}

model Checklist {
  id                   Int                  @id @default(autoincrement())
  tipo                 TipoChecklist
  fecha                DateTime             @default(now())
  equipo_id            Int
  usuario_id           Int?                 
  responsable_nombre   String               @db.VarChar(60) 
  responsable_apellido String               @db.VarChar(60) 
  horas_motor          Int?                 
  observaciones        String?              @db.Text

  equipo               Equipo               @relation(fields: [equipo_id], references: [id], onDelete: Restrict)
  respuestas           ChecklistRespuesta[]
  fotos                ChecklistFoto[]   

  alquiler_entrega     AlquilerEquipo?      @relation("ChecklistEntrega")
  alquiler_devolucion  AlquilerEquipo?      @relation("ChecklistDevolucion")   

  @@map("checklist")
}

model ChecklistRespuesta {
  id                Int           @id @default(autoincrement())
  checklist_id      Int
  plantilla_item_id Int
  estado            EstadoItem
  observacion       String?       @db.Text

  checklist         Checklist     @relation(fields: [checklist_id], references: [id], onDelete: Restrict)
  plantilla_item    PlantillaItem @relation(fields: [plantilla_item_id], references: [id], onDelete: Restrict)

  @@unique([checklist_id, plantilla_item_id])
  @@map("checklist_respuesta")
}

model ChecklistFoto {
  id           Int       @id @default(autoincrement())
  checklist_id Int
  url          String

  checklist    Checklist @relation(fields: [checklist_id], references: [id], onDelete: Restrict)

  @@map("checklist_foto")
}

model Cliente {
  id              Int        @id @default(autoincrement())
  razon_social    String
  cuit            String?    @unique
  contacto_nombre String?
  telefono        String?
  email           String?
  direccion       String?
  localidad       String?
  observaciones   String?
  activo          Boolean    @default(true)
  creado_en       DateTime   @default(now())
  actualizado_en  DateTime   @updatedAt

  alquileres      Alquiler[]

  @@map("clientes")
}

model Alquiler {
  id                     Int              @id @default(autoincrement())
  cliente_id             Int
  usuario_id             Int
  estado                 EstadoAlquiler   @default(PENDIENTE)
  fecha_inicio           DateTime         @db.Date
  fecha_fin_prevista     DateTime         @db.Date
  latitud                Decimal          @db.Decimal(9, 6)
  longitud               Decimal          @db.Decimal(9, 6)
  ubicacion_referencia   String
  contacto_obra_nombre   String?
  contacto_obra_telefono String?
  observaciones          String?
  motivo_anulacion       String?
  creado_en              DateTime         @default(now())
  actualizado_en         DateTime         @updatedAt

  cliente                Cliente          @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  usuario                Usuario          @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  equipos                AlquilerEquipo[]

  @@map("alquileres")
}

model AlquilerEquipo {
  id                      Int        @id @default(autoincrement())
  alquiler_id             Int
  equipo_id               Int
  checklist_entrega_id    Int?       @unique
  checklist_devolucion_id Int?       @unique

  alquiler                Alquiler   @relation(fields: [alquiler_id], references: [id], onDelete: Restrict)
  equipo                  Equipo     @relation(fields: [equipo_id], references: [id], onDelete: Restrict)
  checklist_entrega       Checklist? @relation("ChecklistEntrega", fields: [checklist_entrega_id], references: [id], onDelete: Restrict)
  checklist_devolucion    Checklist? @relation("ChecklistDevolucion", fields: [checklist_devolucion_id], references: [id], onDelete: Restrict)

  @@unique([alquiler_id, equipo_id])
  @@map("alquiler_equipo")
}

model EscalonServicio {
  id              Int     @id @default(autoincrement())
  horas_intervalo Int     @unique
  nombre          String  @db.Text
  descripcion     String? @db.Text

  avisos          Aviso[]

  @@map("escalon_servicio")
}

model Aviso {
  id              Int              @id @default(autoincrement())
  maquina_id      Int
  tipo            TipoAviso
  hito_horas      Int?
  escalon_id      Int?
  vence_el        DateTime?        @db.Date
  estado          EstadoAviso      @default(PENDIENTE)
  nota_atencion   String?          @db.Text
  atendido_por_id Int?
  atendido_en     DateTime?
  notificado_en   DateTime?
  creado_en       DateTime         @default(now())

  maquina         Maquina          @relation(fields: [maquina_id], references: [equipo_id], onDelete: Restrict)
  escalon         EscalonServicio? @relation(fields: [escalon_id], references: [id], onDelete: Restrict)
  atendido_por    Usuario?         @relation(fields: [atendido_por_id], references: [id], onDelete: Restrict)

  @@unique([maquina_id, tipo, hito_horas])
  @@unique([maquina_id, tipo, vence_el])
  @@map("aviso")
}